{
  "name": "n8n-nodes-textkit",
  "version": "0.1.0",
  "description": "n8n nodes for TextKit: send SMS, look up messages, send and check verification codes, and trigger on inbound texts.",
  "keywords": [
    "n8n-community-node-package",
    "textkit",
    "sms",
    "verification",
    "otp"
  ],
  "license": "MIT",
  "homepage": "https://jointextkit.com/docs",
  "author": {
    "name": "TextKit",
    "url": "https://jointextkit.com"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/textkithq/n8n-nodes-textkit.git"
  },
  "engines": {
    "node": ">=20.15"
  },
  "files": [
    "dist"
  ],
  "scripts": {
    "build": "n8n-node build",
    "build:tsc": "tsc -p tsconfig.json && node scripts/copy-icons.mjs",
    "dev": "n8n-node dev",
    "lint": "n8n-node lint",
    "lint:fix": "n8n-node lint --fix",
    "release": "n8n-node release",
    "test": "npm run build:tsc && node --test test/",
    "prepublishOnly": "n8n-node prerelease"
  },
  "n8n": {
    "n8nNodesApiVersion": 1,
    "strict": true,
    "credentials": [
      "dist/credentials/TextKitApi.credentials.js"
    ],
    "nodes": [
      "dist/nodes/TextKit/TextKit.node.js",
      "dist/nodes/TextKitTrigger/TextKitTrigger.node.js"
    ]
  },
  "devDependencies": {
    "@n8n/node-cli": "^0.54.4",
    "@types/node": "^20.14.0",
    "eslint": "9.32.0",
    "n8n-workflow": "^2.16.0",
    "prettier": "3.6.2",
    "release-it": "^21.1.0",
    "typescript": "5.9.2"
  },
  "peerDependencies": {
    "n8n-workflow": "*"
  }
}
